	{
		"id": "to-number-valve",
		"type": "function",
		"z": "lab2",
		"name": "ToNumber",
		"func": "// MQTT передає текст. Порожнє або нечислове значення відкидаємо.\nif (typeof msg.payload !== \"number\" && typeof msg.payload !== \"string\") {\n\treturn null;\n}\nif (typeof msg.payload === \"string\" && msg.payload.trim() === \"\") {\n\treturn null;\n}\nmsg.payload = Number(msg.payload);\nif (!Number.isFinite(msg.payload)) {\n\treturn null;\n}\nreturn msg;",
		"outputs": 1,
		"timeout": 0,
		"noerr": 0,
		"initialize": "",
		"finalize": "",
		"libs": [],
