	{
		"id": "sin",
		"type": "function",
		"z": "lab2",
		"name": "sin",
		"func": "// Під час ручної перевірки генератор вимкнений.\nif (flow.get(\"sineEnabled\") !== true) {\n\treturn null;\n}\nconst a = msg.payload / 10000;\nmsg.payload = (Math.sin(a) + 1.0) * 25.0 + 25;\nreturn msg;",
		"outputs": 1,
